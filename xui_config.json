{
  "enabled": true,
  "mode": "multi-xui",
  "xui_servers": [
    {
      "host": "https://gateway.asgaroth.ru:5560",
      "base_path": "/vpn",
      "timeout": 10,
      "max_retries": 3,
      "plans": ["standard", "premium"],
      "api_token": "your_api_token_here",
      "auth_type": "token",
      "inbound_filter": {
        "protocol": "vless"
      }
    }
  ],
  "inbound_filter": {
    "protocol": "vless"
  }
}
